{
  "name": "ontouml-js",
  "version": "1.1.0",
  "description": "Javascript library to create, edit, and query OntoUML models programmatically.",
  "license": "Apache-2.0",
  "repository": "github:OntoUML/ontouml-js",
  "homepage": "https://ontouml.github.io/ontouml-js/",
  "bugs": {
    "url": "https://github.com/OntoUML/ontouml-js/issues"
  },
  "keywords": [
    "ontouml",
    "ufo",
    "ontology",
    "conceptual-modeling",
    "ontology-driven",
    "metamodel",
    "json-schema"
  ],
  "contributors": [
    {
      "name": "Tiago Prince Sales"
    },
    {
      "name": "Claudenir Morais Fonseca",
      "url": "https://orcid.org/0000-0003-2528-3118",
      "email": "c.moraisfonseca@utwente.nl"
    }
  ],
  "engines": {
    "node": ">= 18"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "jest",
    "testWatch": "jest --watch",
    "lint": "tsc",
    "lintWatch": "tsc --watch",
    "format": "npx prettier . --write",
    "build": "tsup --clean src/index.ts --format cjs,esm --dts",
    "prepublishOnly": "npm run lint && npm run test && npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "language-tags": "^1.0.9",
    "lodash": "^4.18.1",
    "ontouml-schema": "^1.0.2",
    "tslib": "^2.8.1",
    "uniqid": "^5.4.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/language-tags": "^1.0.4",
    "@types/lodash": "^4.17.24",
    "@types/node": "^26.1.1",
    "@types/uniqid": "^5.3.4",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-extended": "^7.0.0",
    "lint-staged": "^17.1.1",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
